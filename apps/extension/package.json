{
  "name": "@solplayer/extension",
  "version": "0.1.1",
  "private": true,
  "description": "SolPlayer Tune - YouTubeのプレイヤーに432Hz変換トグルを注入するChrome拡張",
  "scripts": {
    "build": "esbuild src/content.ts --bundle --format=iife --outfile=dist/content.js && node scripts/copy-assets.mjs",
    "package": "node scripts/pack.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "soundtouchjs": "^0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
