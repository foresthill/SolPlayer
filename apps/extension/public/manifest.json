{
  "manifest_version": 3,
  "name": "SolPlayer Tune",
  "version": "0.2.2",
  "description": "YouTubeの音声をその場で432Hz等に変換して聴く（保存・ダウンロードは一切しません）",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
